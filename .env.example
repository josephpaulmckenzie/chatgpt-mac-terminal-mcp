# Required absolute path to the repository the MCP server is allowed to access.
REPO=/absolute/path/to/your/project

# Optional display name reported by the MCP server.
MCP_SERVER_NAME=mac-terminal

# Optional absolute path for the local Command Center log.
# Defaults to the system temporary directory.
COMMAND_CENTER_LOG=/tmp/chatgpt-mac-terminal-command-center.log

# Comma-separated allowlist. Each script must also exist in REPO/package.json.
ALLOWED_NPM_SCRIPTS=build,test,typecheck

# Optional additional repositories, separated by semicolons.
# Each alias maps to an existing absolute directory. Tools accept the alias
# in their repository parameter. The REPO directory remains available as "default".
ALLOWED_REPOS=collectors-vault=/Users/your-user/Documents/Code/collectors-vault;mac-terminal-mcp=/Users/your-user/Documents/Code/chatgpt-mac-terminal-mcp
